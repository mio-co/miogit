{
  "name": "miogit",
  "version": "0.0.8",
  "description": "Durable git: a git server as a Cloudflare Durable Object. Smart HTTP, a cgit-style web interface, pluggable auth, push events, and a typed content API.",
  "type": "module",
  "main": "src/mod.ts",
  "types": "src/mod.ts",
  "exports": {
    ".": "./src/mod.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "git",
    "cloudflare-workers",
    "durable-objects",
    "cgit",
    "git-server"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littledivy/dgit.git"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "test": "node --experimental-strip-types --test tests/policy.test.ts tests/sealed-box.test.ts && python3 -m unittest discover -s sync/github -p 'test_*.py'",
    "test:e2e": "npm run build:web && node tests/e2e-perms.mjs",
    "build:web": "npm --prefix web run build",
    "test:smoke": "node web/scripts/smoke-render.mjs"
  },
  "dependencies": {
    "blakejs": "^1.2.1",
    "pako": "^2.1.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/pako": "^2.0.3",
    "typescript": "^5.5.0",
    "wrangler": "^4.0.0"
  }
}
