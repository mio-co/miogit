{
  // dgit: a cgit-style git host that runs entirely on Cloudflare.
  // Each repository lives in its own SQLite-backed Durable Object ("cell").
  // NOTE: the script name stays "git-cells" — Durable Object data is bound
  // to it, and renaming would orphan every hosted repository.
  "name": "git-cells",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "routes": [
    { "pattern": "miogit.300031.xyz", "custom_domain": true }
  ],
  // React frontend (web/ -> web/dist). Hashed files live under /~static/ ("~"
  // never starts a repository name) and are served straight from the edge;
  // every other request runs the Worker first, which keeps git smart HTTP,
  // the API, redirects and the console gates exactly as before and answers
  // frontend pages with index.html (env.ASSETS) plus the first data inlined.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/~static/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "REPO", "class_name": "RepoCell" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RepoCell", "Registry"] }
  ],
  // Optional: with PACK_CACHE bound, pushed pack bytes are stored in R2 (off the
  // DO's SQLite) and full clones are served straight from R2 by the Worker.
  // Remove this binding to fall back to the SQLite-only path (as on celld).
  "r2_buckets": [
    { "binding": "PACK_CACHE", "bucket_name": "dgit-pack-cache" }
  ],
  "vars": {
    "SITE_NAME": "MioGit",
    "CANONICAL_HOST": "miogit.300031.xyz",
    "SITE_DESC": "",
    "SITE_OWNER": "mio",
    // web console (/~mio/): username; the password hash is the ADMIN_PASSWORD_HASH secret
    "ADMIN_USER": "mio",
    // Cloudflare Access application protecting miogit.300031.xyz/~mio/ (JWT re-verified in the Worker)
    "ACCESS_TEAM_DOMAIN": "sakune.cloudflareaccess.com",
    "ACCESS_AUD": "f90993d75929ac959c7490b9ab4e78817613bb17e7e42cfe72e205b4348f342a"
  }
  // Secrets (wrangler secret put …; .dev.vars locally):
  //   GIT_TOKEN            admin git token (the original push password)
  //   ADMIN_PASSWORD_HASH  console password, "pbkdf2-sha256$100000$<salt>$<hash>"
  //                        (node scripts/hash-password.mjs prints one)
  // Per-assistant git tokens are created in the console (/~mio/tokens) and
  // stored as SHA-256 hashes in the Registry Durable Object.
}
